# Telegram API - Get from https://my.telegram.org
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=test_hash
TELEGRAM_PHONE=+1234567890

# OpenRouter API - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=test_key
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE=0.3

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/telegram_jobs

# Job Search Channels
JOB_CHANNELS=@test1 @test2

# Your Profile for Job Matching
USER_PROFILE=Test profile

# Optional: Minimum relevance score (0-1)
MIN_RELEVANCE_SCORE=0.7

# Scheduler - Fetch interval in seconds (default 30 min)
FETCH_INTERVAL_SECONDS=1800