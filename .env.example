# Telegram API - Get from https://my.telegram.org
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890  # Your phone number with country code

# OpenRouter API - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
LLM_MODEL=anthropic/claude-sonnet-5
LLM_TEMPERATURE=0.3

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telegram_jobs

# Job Search Channels - Space-separated list of @usernames or channel IDs
JOB_CHANNELS=@jobschannel1 @jobschannel2 @remotework

# Your Profile for Job Matching
USER_PROFILE=Senior Python/Go Developer with 5+ years experience in backend, cloud (AWS/GCP), Kubernetes, and distributed systems. Looking for remote positions with visa sponsorship.

# Optional: Minimum relevance score (0-1)
MIN_RELEVANCE_SCORE=0.7

# Scheduler - Fetch interval in seconds (default 30 min)
FETCH_INTERVAL_SECONDS=1800